# Required: Sepolia RPC used by the demo API to verify payments on-chain.
RATION_DEMO_RPC_URL=https://YOUR_SEPOLIA_RPC

# Required: dedicated non-zero Sepolia EOA that receives demo USDT.
# Do not use the Ration treasury or an ephemeral sandbox address.
RATION_DEMO_SELLER_ADDRESS=0xYOUR_DEDICATED_SELLER_ADDRESS

# Optional: separate Sepolia-only sink used by the adversarial demo resource.
# RATION_DEMO_TESTNET_ATTACKER_ADDRESS=0xYOUR_TESTNET_ATTACKER_ADDRESS

# Optional fixed network values. Overrides are rejected unless they match these values.
# RATION_DEMO_USDT_ADDRESS=0xd077A400968890Eacc75cdc901F0356c943e4fDb
# RATION_DEMO_CHAIN_ID=11155111

# Optional: local file used to prevent transaction-hash reuse by the demo API.
# RATION_DEMO_REDEMPTIONS_PATH=/absolute/path/ration-demo-redemptions.json
